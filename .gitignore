# 题库可从上游重建，不进版本库（约 85MB）
hongjuan.db
hongjuan.db-wal
hongjuan.db-shm

# Python
__pycache__/
*.py[cod]

# 构建与调试的临时文件
.tmp*

# 安卓构建产物：assets 里是复制过去的题库与图片，由 build_apk.py 重新生成
android/assets/
android/build/
android/hongjuan.keystore

# 安装包与签名附属文件
*.apk
*.aab
*.idsig
*.keystore

# 临时局域网共享目录
.share/

# DSH 会话元数据
.dsh-ops/

# 本机签名密码（build_apk.py 优先读环境变量 HJ_KS_PASS，其次读这里）
android/.kspass

# 个人工作记录：含本机路径与私人偏好，不随代码公开
memory/

# 编辑器与系统
.idea/
.vscode/
*.iml
*.log
Thumbs.db
.DS_Store

# 给自己的开发笔记，不在公开仓库里
HANDOFF.md

# 临时压缩包
*.zip
